DATABASE_URL="postgresql://grocery:grocery@localhost:5433/grocery?schema=public"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_WHATSAPP=""

# Shown on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=""

# Online payments (Stripe). Leave empty to hide "Pay online" at checkout.
# Keys: https://dashboard.stripe.com/test/apikeys  (use sk_test_… while testing)
STRIPE_SECRET_KEY=""
# Signing secret of your webhook endpoint (whsec_…), from the Dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET=""
# Public address of the shop, used for Stripe return links, e.g. https://threetyres.de
APP_URL=""

# Bot check at checkout (Cloudflare Turnstile, free). Leave empty to turn it off.
# Keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Secret for the scheduled clean-up call (/api/cron/cleanup). Any long random string.
CRON_SECRET=""

# Business details for the Impressum and legal pages (§ 5 DDG). Required before launch.
BUSINESS_LEGAL_NAME=""        # e.g. "Jane Doe" or "Three Tyres Grocery UG (haftungsbeschränkt)"
BUSINESS_REPRESENTATIVE=""    # for a company: managing director's name; leave empty for a sole trader
BUSINESS_STREET=""            # e.g. "Musterstraße 1"
BUSINESS_POSTCODE_CITY=""     # e.g. "10115 Berlin"
BUSINESS_PHONE=""             # e.g. "+49 176 20587997"
BUSINESS_VAT_ID=""            # USt-IdNr., if you have one
BUSINESS_REGISTER=""          # e.g. "Amtsgericht Charlottenburg, HRB 12345 B" (companies only)

# Order emails and alerts (all optional).
# Local testing: SMTP_URL="smtp://localhost:1025" and read mail at http://localhost:8025 (Mailpit, in docker-compose).
# Live: your email provider's SMTP, e.g. "smtps://user:password@smtp.provider.com:465"
# Brevo (free, 300 emails/day): "smtp://<login, @ as %40>:<SMTP key>@smtp-relay.brevo.com:587"
# (Brevo > SMTP & API > SMTP). MAIL_FROM must be a sender verified in Brevo.
SMTP_URL=""
MAIL_FROM=""            # e.g. "Three Tyres Grocery <orders@your-domain.de>"
SHOP_NOTIFY_EMAIL=""    # your inbox for new-order alerts
MAIL_REPLY_TO=""        # where customers' replies go (defaults to the contact email); set it when Brevo rewrites a Gmail sender
# Telegram alerts: create a bot with @BotFather, send it a message, then get your chat id
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# WhatsApp alerts via CallMeBot (free, unofficial): save +34 684 783 708 (check callmebot.com, it changes) in your contacts, send it
# "I allow callmebot to send me messages", and put the API key it replies with here.
CALLMEBOT_PHONE=""      # your own WhatsApp number, e.g. "+4917620587997"
CALLMEBOT_APIKEY=""
