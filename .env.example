DATABASE_URL="postgresql://grocery:grocery@localhost:5433/grocery?schema=public"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_WHATSAPP=""

# Shown on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=""

# Online payments (Stripe). Leave empty to hide "Pay online" at checkout.
# Keys: https://dashboard.stripe.com/test/apikeys  (use sk_test_… while testing)
STRIPE_SECRET_KEY=""
# Signing secret of your webhook endpoint (whsec_…), from the Dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET=""
# Public address of the shop, used for Stripe return links, e.g. https://threetyres.de
APP_URL=""

# Bot check at checkout (Cloudflare Turnstile, free). Leave empty to turn it off.
# Keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Secret for the scheduled clean-up call (/api/cron/cleanup). Any long random string.
CRON_SECRET=""

# Business details for the Impressum and legal pages (§ 5 DDG). Required before launch.
BUSINESS_LEGAL_NAME=""        # e.g. "Jane Doe" or "Three Tyres Grocery UG (haftungsbeschränkt)"
BUSINESS_REPRESENTATIVE=""    # for a company: managing director's name; leave empty for a sole trader
BUSINESS_STREET=""            # e.g. "Musterstraße 1"
BUSINESS_POSTCODE_CITY=""     # e.g. "10115 Berlin"
BUSINESS_PHONE=""             # e.g. "+49 176 20587997"
BUSINESS_VAT_ID=""            # USt-IdNr., if you have one
BUSINESS_REGISTER=""          # e.g. "Amtsgericht Charlottenburg, HRB 12345 B" (companies only)
